{
  "name": "meeting-prep-agent",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@10.34.7",
  "engines": { "node": ">=22" },
  "scripts": {
    "lint": "pnpm lint:ts && pnpm lint:py",
    "lint:ts": "eslint .",
    "lint:py": "cd agent && uv run ruff check . && uv run ruff format --check .",
    "typecheck": "pnpm typecheck:ts && pnpm typecheck:py",
    "typecheck:ts": "pnpm -r --if-present typecheck",
    "typecheck:py": "cd agent && uv run mypy src tests scripts",
    "test:ts": "pnpm -r --if-present test",
    "test:py": "cd agent && uv run pytest",
    "check": "pnpm lint && pnpm typecheck && pnpm test:ts && pnpm test:py"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
