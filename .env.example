# Names only. Copy to .env (gitignored) and fill in locally. Never commit values.

# LiteLLM proxy (OpenAI-compatible). Treat the base URL as secret too.
LITELLM_BASE_URL=
LITELLM_API_KEY=
# LiteLLM model alias used for all agent calls
LLM_MODEL=
# Model that judges `make eval` runs (default: a stronger model than LLM_MODEL; `same` = LLM_MODEL)
JUDGE_MODEL=
# live | replay (replay serves data/recordings/, offline, no key needed)
LLM_MODE=replay
# set RECORD=1 in live mode to write recordings to data/recordings/
RECORD=

# snapshot (default, reads data/) | graph (stub, raises NotImplementedError)
DATA_SOURCE=snapshot
# Fixed "now" for the fake dataset (ISO 8601); meetings are resolved relative to it
DEMO_NOW=
# Fault injection: news | email | docs | all
FAIL_SOURCE=

# Budgets per run
MAX_STEPS_PER_AGENT=
MAX_TOKENS=
MAX_COST_USD=

# Tracing: off | langfuse (optional local Langfuse, see docker-compose.yml)
TRACING=off
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
