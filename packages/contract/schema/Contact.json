{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Contact",
  "$defs": {
    "Contact": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "contact"
        },
        "id": {
          "type": "string",
          "pattern": "^P[0-9]{1,9}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "maxLength": 100
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "is_user": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "id",
        "name",
        "email",
        "organization",
        "role",
        "notes",
        "is_user"
      ],
      "additionalProperties": false
    }
  }
}
