{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Doc",
  "$defs": {
    "Doc": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "doc"
        },
        "id": {
          "type": "string",
          "pattern": "^D[0-9]{1,9}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "enum": [
            "proposal",
            "notes",
            "contract",
            "other"
          ]
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3})?Z$",
          "description": "ISO-8601 UTC timestamp: YYYY-MM-DDTHH:MM:SS[.sss]Z"
        },
        "body": {
          "type": "string",
          "maxLength": 12000
        }
      },
      "required": [
        "type",
        "id",
        "title",
        "kind",
        "author",
        "date",
        "body"
      ],
      "additionalProperties": false
    }
  }
}
