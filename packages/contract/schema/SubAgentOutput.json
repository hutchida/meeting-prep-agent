{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SubAgentOutput",
  "$defs": {
    "SubAgentOutput": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "enum": [
            "correspondence",
            "documents",
            "news",
            "attendees"
          ]
        },
        "findings": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Sentence"
          }
        },
        "gaps": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Gap"
          }
        }
      },
      "required": [
        "agent",
        "findings",
        "gaps"
      ],
      "additionalProperties": false
    },
    "Sentence": {
      "anyOf": [
        {
          "$ref": "#/$defs/FactSentence"
        },
        {
          "$ref": "#/$defs/NoteSentence"
        }
      ]
    },
    "FactSentence": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "citations": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          }
        },
        "kind": {
          "type": "string",
          "const": "fact"
        }
      },
      "required": [
        "text",
        "citations"
      ],
      "additionalProperties": false
    },
    "Citation": {
      "oneOf": [
        {
          "$ref": "#/$defs/CitationEmail"
        },
        {
          "$ref": "#/$defs/CitationChat"
        },
        {
          "$ref": "#/$defs/CitationDoc"
        },
        {
          "$ref": "#/$defs/CitationNews"
        },
        {
          "$ref": "#/$defs/CitationContact"
        },
        {
          "$ref": "#/$defs/CitationCal"
        }
      ]
    },
    "CitationEmail": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "email"
        },
        "id": {
          "type": "string",
          "pattern": "^E[0-9]{1,9}$"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "CitationChat": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "chat"
        },
        "id": {
          "type": "string",
          "pattern": "^C[0-9]{1,9}$"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "CitationDoc": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "doc"
        },
        "id": {
          "type": "string",
          "pattern": "^D[0-9]{1,9}$"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "CitationNews": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "news"
        },
        "id": {
          "type": "string",
          "pattern": "^N[0-9]{1,9}$"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "CitationContact": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "contact"
        },
        "id": {
          "type": "string",
          "pattern": "^P[0-9]{1,9}$"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "CitationCal": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "cal"
        },
        "id": {
          "type": "string",
          "pattern": "^M[0-9]{1,9}$"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "NoteSentence": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "citations": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          }
        },
        "kind": {
          "type": "string",
          "const": "note"
        }
      },
      "required": [
        "text",
        "citations",
        "kind"
      ],
      "additionalProperties": false
    },
    "Gap": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "email",
            "chat",
            "docs",
            "news",
            "calendar",
            "contacts"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "timeout",
            "fault_injected",
            "budget",
            "error"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "source",
        "reason",
        "detail"
      ],
      "additionalProperties": false,
      "description": "A part of the briefing that is missing, and why."
    }
  }
}
