{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Citation",
  "$defs": {
    "Citation": {
      "oneOf": [
        {
          "$ref": "#/$defs/CitationEmail"
        },
        {
          "$ref": "#/$defs/CitationChat"
        },
        {
          "$ref": "#/$defs/CitationDoc"
        },
        {
          "$ref": "#/$defs/CitationNews"
        },
        {
          "$ref": "#/$defs/CitationContact"
        },
        {
          "$ref": "#/$defs/CitationCal"
        }
      ]
    },
    "CitationEmail": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "email"
        },
        "id": {
          "type": "string",
          "pattern": "^E[0-9]{1,9}$"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "CitationChat": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "chat"
        },
        "id": {
          "type": "string",
          "pattern": "^C[0-9]{1,9}$"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "CitationDoc": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "doc"
        },
        "id": {
          "type": "string",
          "pattern": "^D[0-9]{1,9}$"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "CitationNews": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "news"
        },
        "id": {
          "type": "string",
          "pattern": "^N[0-9]{1,9}$"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "CitationContact": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "contact"
        },
        "id": {
          "type": "string",
          "pattern": "^P[0-9]{1,9}$"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "CitationCal": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "cal"
        },
        "id": {
          "type": "string",
          "pattern": "^M[0-9]{1,9}$"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    }
  }
}
