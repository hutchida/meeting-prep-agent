{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/NewsItem",
  "$defs": {
    "NewsItem": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "news"
        },
        "id": {
          "type": "string",
          "pattern": "^N[0-9]{1,9}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "published": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3})?Z$",
          "description": "ISO-8601 UTC timestamp: YYYY-MM-DDTHH:MM:SS[.sss]Z"
        },
        "url": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^https:\\/\\/example\\.test\\/[^\\s]*$"
        },
        "body": {
          "type": "string",
          "maxLength": 4000
        },
        "about": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "type",
        "id",
        "title",
        "source",
        "published",
        "url",
        "body"
      ],
      "additionalProperties": false
    }
  }
}
