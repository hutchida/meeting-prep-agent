{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ToolResult",
  "$defs": {
    "ToolResult": {
      "type": "object",
      "properties": {
        "items": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/SearchHit"
              },
              {
                "$ref": "#/$defs/SourceItem"
              }
            ]
          }
        },
        "total_matches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "items",
        "total_matches",
        "truncated"
      ],
      "additionalProperties": false
    },
    "SearchHit": {
      "oneOf": [
        {
          "$ref": "#/$defs/SearchHitEmail"
        },
        {
          "$ref": "#/$defs/SearchHitChat"
        },
        {
          "$ref": "#/$defs/SearchHitDoc"
        },
        {
          "$ref": "#/$defs/SearchHitNews"
        },
        {
          "$ref": "#/$defs/SearchHitContact"
        },
        {
          "$ref": "#/$defs/SearchHitCal"
        }
      ]
    },
    "SearchHitEmail": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "email"
        },
        "id": {
          "type": "string",
          "pattern": "^E[0-9]{1,9}$"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "snippet": {
          "type": "string",
          "maxLength": 400
        },
        "score": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "id",
        "title",
        "snippet",
        "score"
      ],
      "additionalProperties": false
    },
    "SearchHitChat": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "chat"
        },
        "id": {
          "type": "string",
          "pattern": "^C[0-9]{1,9}$"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "snippet": {
          "type": "string",
          "maxLength": 400
        },
        "score": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "id",
        "title",
        "snippet",
        "score"
      ],
      "additionalProperties": false
    },
    "SearchHitDoc": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "doc"
        },
        "id": {
          "type": "string",
          "pattern": "^D[0-9]{1,9}$"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "snippet": {
          "type": "string",
          "maxLength": 400
        },
        "score": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "id",
        "title",
        "snippet",
        "score"
      ],
      "additionalProperties": false
    },
    "SearchHitNews": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "news"
        },
        "id": {
          "type": "string",
          "pattern": "^N[0-9]{1,9}$"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "snippet": {
          "type": "string",
          "maxLength": 400
        },
        "score": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "id",
        "title",
        "snippet",
        "score"
      ],
      "additionalProperties": false
    },
    "SearchHitContact": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "contact"
        },
        "id": {
          "type": "string",
          "pattern": "^P[0-9]{1,9}$"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "snippet": {
          "type": "string",
          "maxLength": 400
        },
        "score": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "id",
        "title",
        "snippet",
        "score"
      ],
      "additionalProperties": false
    },
    "SearchHitCal": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "cal"
        },
        "id": {
          "type": "string",
          "pattern": "^M[0-9]{1,9}$"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "snippet": {
          "type": "string",
          "maxLength": 400
        },
        "score": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "id",
        "title",
        "snippet",
        "score"
      ],
      "additionalProperties": false
    },
    "SourceItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/Email"
        },
        {
          "$ref": "#/$defs/ChatMessage"
        },
        {
          "$ref": "#/$defs/Doc"
        },
        {
          "$ref": "#/$defs/CalendarEvent"
        },
        {
          "$ref": "#/$defs/Contact"
        },
        {
          "$ref": "#/$defs/NewsItem"
        }
      ]
    },
    "Email": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "email"
        },
        "id": {
          "type": "string",
          "pattern": "^E[0-9]{1,9}$"
        },
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sender": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "to": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[^@\\s]+@[^@\\s]+$"
          }
        },
        "cc": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[^@\\s]+@[^@\\s]+$"
          }
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3})?Z$",
          "description": "ISO-8601 UTC timestamp: YYYY-MM-DDTHH:MM:SS[.sss]Z"
        },
        "subject": {
          "type": "string",
          "maxLength": 300
        },
        "body": {
          "type": "string",
          "maxLength": 6144
        },
        "origin": {
          "type": "string",
          "enum": [
            "synthetic",
            "enron"
          ]
        }
      },
      "required": [
        "type",
        "id",
        "thread_id",
        "sender",
        "to",
        "cc",
        "date",
        "subject",
        "body"
      ],
      "additionalProperties": false
    },
    "ChatMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "chat"
        },
        "id": {
          "type": "string",
          "pattern": "^C[0-9]{1,9}$"
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "ts": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3})?Z$",
          "description": "ISO-8601 UTC timestamp: YYYY-MM-DDTHH:MM:SS[.sss]Z"
        },
        "text": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "type",
        "id",
        "channel",
        "author",
        "ts",
        "text"
      ],
      "additionalProperties": false
    },
    "Doc": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "doc"
        },
        "id": {
          "type": "string",
          "pattern": "^D[0-9]{1,9}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "enum": [
            "proposal",
            "notes",
            "contract",
            "other"
          ]
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3})?Z$",
          "description": "ISO-8601 UTC timestamp: YYYY-MM-DDTHH:MM:SS[.sss]Z"
        },
        "body": {
          "type": "string",
          "maxLength": 12000
        }
      },
      "required": [
        "type",
        "id",
        "title",
        "kind",
        "author",
        "date",
        "body"
      ],
      "additionalProperties": false
    },
    "CalendarEvent": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "cal"
        },
        "id": {
          "type": "string",
          "pattern": "^M[0-9]{1,9}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3})?Z$",
          "description": "ISO-8601 UTC timestamp: YYYY-MM-DDTHH:MM:SS[.sss]Z"
        },
        "end": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3})?Z$",
          "description": "ISO-8601 UTC timestamp: YYYY-MM-DDTHH:MM:SS[.sss]Z"
        },
        "attendees": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^P[0-9]{1,9}$"
          }
        },
        "location": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "type",
        "id",
        "title",
        "start",
        "end",
        "attendees",
        "location",
        "description"
      ],
      "additionalProperties": false
    },
    "Contact": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "contact"
        },
        "id": {
          "type": "string",
          "pattern": "^P[0-9]{1,9}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "maxLength": 100
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "is_user": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "id",
        "name",
        "email",
        "organization",
        "role",
        "notes",
        "is_user"
      ],
      "additionalProperties": false
    },
    "NewsItem": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "news"
        },
        "id": {
          "type": "string",
          "pattern": "^N[0-9]{1,9}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "published": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3})?Z$",
          "description": "ISO-8601 UTC timestamp: YYYY-MM-DDTHH:MM:SS[.sss]Z"
        },
        "url": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^https:\\/\\/example\\.test\\/[^\\s]*$"
        },
        "body": {
          "type": "string",
          "maxLength": 4000
        },
        "about": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "type",
        "id",
        "title",
        "source",
        "published",
        "url",
        "body"
      ],
      "additionalProperties": false
    }
  }
}
