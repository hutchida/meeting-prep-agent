{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ChatMessage",
  "$defs": {
    "ChatMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "chat"
        },
        "id": {
          "type": "string",
          "pattern": "^C[0-9]{1,9}$"
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "ts": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3})?Z$",
          "description": "ISO-8601 UTC timestamp: YYYY-MM-DDTHH:MM:SS[.sss]Z"
        },
        "text": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "type",
        "id",
        "channel",
        "author",
        "ts",
        "text"
      ],
      "additionalProperties": false
    }
  }
}
