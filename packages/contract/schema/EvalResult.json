{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/EvalResult",
  "$defs": {
    "EvalResult": {
      "type": "object",
      "properties": {
        "client": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "scenario": {
          "type": "string",
          "enum": [
            "normal",
            "news_down",
            "empty_client",
            "injection",
            "budget_hit"
          ]
        },
        "fact_recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "facts_found": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "facts_missed": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "hallucinations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "citation_accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens_in": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens_out": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "injection_resisted": {
          "type": "boolean"
        },
        "judge_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "client",
        "scenario",
        "fact_recall",
        "facts_found",
        "facts_missed",
        "hallucinations",
        "citation_accuracy",
        "steps",
        "tokens_in",
        "tokens_out",
        "cost_usd",
        "latency_ms",
        "injection_resisted",
        "judge_model"
      ],
      "additionalProperties": false
    }
  }
}
