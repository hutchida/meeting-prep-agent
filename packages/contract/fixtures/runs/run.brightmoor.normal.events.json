        "title": "Client snapshot",
        "sentences": [
          {
            "text": "Northwind advises Brightmoor Renewables on the PPA for the Fenmoor wind farm under a fixed fee of £48,000.",
            "citations": [
              {
                "type": "doc",
                "id": "D7"
              }
            ]
          },
          {
            "text": "The offtaker is Tarn Valley Utilities.",
