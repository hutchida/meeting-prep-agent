              {
                "type": "doc",
                "id": "D3"
              },
              {
                "type": "doc",
                "id": "D8"
              }
            ]
          },
          {
            "text": "Lender Ashgrove Bank requires 70% contracted revenue and the PPA signed before financial close, which is targeted for 30 June 2026.",
            "citations": [
              {
                "type": "doc",
                "id": "D8"
              },
              {
                "type": "email",
                "id": "E41"
